# Configuração do VRSync. Ajuste SOURCE_URI e LOG_FILE para sua máquina.
# Busca padrão: vrsync.env na pasta atual; depois, ao lado do executável.
# Outro arquivo: vrsync -config caminho.env ou variável VRSYNC_CONFIG.
# Variáveis de ambiente VRSYNC_<CHAVE> prevalecem sobre o arquivo.

# Conexões

# Origem na nuvem, em Replica Set. Substitua host
# SOURCE_URI=mongodb://usuario:senha@mongo.nuvem.com.br:27017/?directConnection=true
SOURCE_URI=mongodb+srv://kauesena_db_user:AEen7SJeZA9tHN89@cluster0.fhaizhs.mongodb.net/pdv?retryWrites=true&w=majority&appName=Cluster0
# Destino local do PDV, em modo standalone.
TARGET_URI=mongodb://localhost:27017/?directConnection=true
# Banco que será copiado da origem para o destino.
DATABASE=pdv
# Banco local do checkpoint: guarda onde a replicação parou. Não apague.
STATE_DATABASE=vrsync
# Identificação do PDV no checkpoint e no jitter. Ausente = nome da máquina.
#INSTANCE_ID=

# Coleções

# Coleções ignoradas: não são copiadas nem apagadas pelo VRSync.
EXCLUDE_COLLECTIONS=scanntechvenda,scanntechfechamentodiario
# Restringe a cópia a uma lista, ex.: produtos,operadores. Vazio = todas,
# respeitando as exclusões acima e as coleções de sistema.
#INCLUDE_COLLECTIONS=

# Carga completa

# auto = carrega se necessário; always = carrega a cada início.
# never = dispensa a carga inicial opcional, mas não impede recuperação
# nem a carga exigida pelo loop quando não há checkpoint.
FULL_LOAD_ON_START=auto
# Agenda no horário local da máquina. Exemplos:
# off ou vazio = sem agenda; 03:00 = diária; 03:00,15:30 = duas por dia;
# @every 6h = a cada 6 horas. Recuperações podem ocorrer fora da agenda.
FULL_LOAD_SCHEDULE=03:00
# Janela para distribuir horários fixos por PDV: 03:00 + 60m fica entre
# 03:00 e antes de 04:00. 0 desliga; não altera @every nem o incremental.
# Também limita a espera aleatória na recuperação, até dois minutos.
FULL_LOAD_JITTER=60m
# Remove dados locais que não existem na origem, respeitando os filtros.
FULL_LOAD_RECONCILE=true
# Quantidade de coleções copiadas ao mesmo tempo na carga completa.
FULL_LOAD_WORKERS=4
# Copia os índices durante a carga completa.
COPY_INDEXES=true

# Desempenho e conexão

# lookup = substitui pelo documento inteiro; delta = aplica os campos
# alterados, buscando o documento inteiro quando necessário.
UPDATE_MODE=lookup
# Limite de conexões por servidor em cada cliente MongoDB (origem e destino).
# Deve ser pelo menos FULL_LOAD_WORKERS + 1; conexões de monitoramento são extras.
MAX_POOL_SIZE=10
# Tamanho dos lotes de cópia e limite de eventos acumulados no incremental.
BATCH_SIZE=1000
# Intervalo para gravar lotes parciais do stream. Ex.: 500ms, 1s, 2s.
FLUSH_INTERVAL=1s
# Espera antes de tentar novamente após uma falha. Ex.: 5s, 30s.
RETRY_INTERVAL=5s
# Tempo para selecionar um servidor; também limita o ping inicial.
CONNECT_TIMEOUT=30s
# Tempo sem resposta da origem para acusar falta de contato em /health.
STALE_AFTER=2m

# Monitoramento

# Endereço da API: GET /status, GET /health e POST /carga.
# /health responde 200 quando saudável e 503 em carga, falha ou falta de contato.
HTTP_ADDR=127.0.0.1:28299
# Arquivo de log, além do console. Vazio = somente console.
# Windows: C:\VRPdv\log-vrsync\vrsync.log; Linux: /home/usuario/vrpdv/vrsync.log.
LOG_FILE=C:\VRPdv\log-vrsync\vrsync.log
# Ativa mensagens detalhadas para diagnóstico.
VERBOSE=false
# false mantém o serviço inativo, sem replicar nem alterar o MongoDB local.
ENABLED=true
